#include <iostream>
#include <stdexcept>
#include <vector>
#include <cstdlib>


class IntegerOutOfBounds : public std::exception {
public:
    IntegerOutOfBounds(const std::string& message) : msg(message) {}
    const char* what() const noexcept override {
        return msg.c_str();
    }
private:
    std::string msg;
};


class WierszTrojkataPascala {
private:
    int numer;
    std::vector<int> wiersz;

public:
    WierszTrojkataPascala(int n) {
        if (n < 0) {
            throw IntegerOutOfBounds("nieprawidłowy numer wiersza");
        }
        numer = n;
    }

    void GenerateRow() {
        wiersz.resize(numer + 1);
        for (int i = 0; i <= numer; i++) {
            wiersz[i] = Silnia(numer, numer - i + 1) / Silnia(i, 1);
        }
    }

    int GetElement(int i) {
        if (i < 0 || i > numer) {
            throw IntegerOutOfBounds("liczba spoza zakresu");
        }
        return wiersz[i];
    }

private:
    int Silnia(int n, int start) {
        int ret = 1;
        for (int i = start; i <= n; i++) {
            ret *= i;
        }
        return ret;
    }
};

