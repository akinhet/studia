#include <iostream>
#include <vector>
#include <string>
#include <memory>
#include <stdexcept>
#include <cmath>

using namespace std;

class Figura {
public:
    virtual string name() const = 0;
    virtual double pole() const = 0;
    virtual double obwod() const = 0;
    virtual ~Figura() {}
};

class Kolo : public Figura {
    int r;

public:
    Kolo(int r) {
        if (r < 0) throw invalid_argument("argument cannot be negative");
        this->r = r;
    }

    double pole() const override {
        return 3.14 * r * r;
    }

    double obwod() const override {
        return 6.28 * r;
    }

    string name() const override {
        return "Koło";
    }
};

class Pieciokat : public Figura {
    int a;

public:
    Pieciokat(int a) {
        if (a < 0) throw invalid_argument("argument cannot be negative");
        this->a = a;
    }

    double pole() const override {
        return (5.0 / 4.0) * a * a * (1.0 / tan(M_PI / 5));
    }

    double obwod() const override {
        return 5 * a;
    }

    string name() const override {
        return "Pięciokąt";
    }
};

class Szesciokat : public Figura {
    int a;

public:
    Szesciokat(int a) {
        if (a < 0) throw invalid_argument("argument cannot be negative");
        this->a = a;
    }

    double pole() const override {
        return ((3 * sqrt(3)) / 2) * a * a;
    }

    double obwod() const override {
        return 6 * a;
    }

    string name() const override {
        return "Sześciokąt";
    }
};

class Kwadrat : public Figura {
    int a;

public:
    Kwadrat(int a) {
        if (a < 0) throw invalid_argument("argument cannot be negative");
        this->a = a;
    }

    double pole() const override {
        return a * a;
    }

    double obwod() const override {
        return 4 * a;
    }

    string name() const override {
        return "Kwadrat";
    }
};

class Romb : public Figura {
    int a, kat;

public:
    Romb(int a, int kat) {
        if (a < 0 || kat <= 0 || kat >= 180)
            throw invalid_argument("invalid argument for Romb");
        this->a = a;
        this->kat = kat;
    }

    double pole() const override {
        double rad = kat * M_PI / 180.0;
        return a * a * sin(rad);
    }

    double obwod() const override {
        return 4 * a;
    }

    string name() const override {
        return "Romb";
    }
};

class Prostokat : public Figura {
    int a, b;

public:
    Prostokat(int a, int c, int b, int d) {
        if (a < 0 || b < 0 || c < 0 || d < 0)
            throw invalid_argument("side length cannot be negative");
        if (a != c || b != d)
            throw invalid_argument("opposite sides must be equal for a rectangle");
        this->a = a;
        this->b = b;
    }

    double pole() const override {
        return a * b;
    }

    double obwod() const override {
        return 2 * (a + b);
    }

    string name() const override {
        return "Prostokąt";
    }
};

int main(int argc, char* argv[]) {
    vector<unique_ptr<Figura>> figury;
    int i = 1;

    while (i < argc) {
        string arg = argv[i];
        try {
            if (arg == "o") {
                int r = stoi(argv[++i]);
                figury.push_back(make_unique<Kolo>(r));
            } else if (arg == "p") {
                int a = stoi(argv[++i]);
                figury.push_back(make_unique<Pieciokat>(a));
            } else if (arg == "s") {
                int a = stoi(argv[++i]);
                figury.push_back(make_unique<Szesciokat>(a));
            } else if (arg == "c") {
                vector<int> cargs;
                string tokens = "cops";
                while (++i < argc && tokens.find(argv[i]) == string::npos) {
                    cargs.push_back(stoi(argv[i]));
                }
                i--;

                if (cargs.size() == 2) {
                    if (cargs[1] == 90)
                        figury.push_back(make_unique<Kwadrat>(cargs[0]));
                    else
                        figury.push_back(make_unique<Romb>(cargs[0], cargs[1]));
                } else if (cargs.size() == 5) {
                    if (cargs[4] != 90) {
                        cerr << "ERROR: unsupported shape" << endl;
                        return 1;
                    }
                    figury.push_back(make_unique<Prostokat>(cargs[0], cargs[1], cargs[2], cargs[3]));
                } else {
                    cerr << "ERROR: illegal amount of arguments for Czworokat class: " << cargs.size() << endl;
                    return 1;
                }
            } else {
                cerr << "ERROR: illegal instruction: " << arg << endl;
                return 1;
            }
        } catch (invalid_argument& e) {
            //cerr << "ERROR: illegal argument to a shape: " << argv[i] << endl;
            cerr << "ERROR: illegal argument to a shape: " << e.what() << endl;
            return 1;
        } catch (exception& e) {
            cerr << "ERROR: " << e.what() << endl;
            return 1;
        }
        ++i;
    }

    for (const auto& f : figury) {
        cout << f->name() << " - Pole: " << f->pole() << " Obwód: " << f->obwod() << endl;
    }

    return 0;
}
