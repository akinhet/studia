From 233a0a4b07b5dcd037a44735de3ad2b2bc181764 Mon Sep 17 00:00:00 2001
From: akinhet <piotrzieniewicz2@gmail.com>
Date: Sun, 11 Jan 2026 22:12:16 +0100
Subject: [PATCH] zad3

---
 Makefile  |  1 +
 defs.h    |  2 ++
 main.c    |  1 +
 syscall.c |  2 ++
 syscall.h |  1 +
 sysproc.c |  8 +++++++
 testshm.c | 23 ++++++++++++++++++
 user.h    |  1 +
 usys.S    |  1 +
 vm.c      | 72 +++++++++++++++++++++++++++++++++++++++++++++++++++++--
 10 files changed, 110 insertions(+), 2 deletions(-)
 create mode 100644 testshm.c

diff --git a/Makefile b/Makefile
index 3f4dbb7..8b672b1 100644
--- a/Makefile
+++ b/Makefile
@@ -183,6 +183,7 @@ UPROGS=\
 	_usertests\
 	_wc\
 	_zombie\
+	_testshm\
 
 fs.img: mkfs README $(UPROGS)
 	./mkfs fs.img README $(UPROGS)
diff --git a/defs.h b/defs.h
index 82fb982..92c77f1 100644
--- a/defs.h
+++ b/defs.h
@@ -185,6 +185,8 @@ void            switchuvm(struct proc*);
 void            switchkvm(void);
 int             copyout(pde_t*, uint, void*, uint);
 void            clearpteu(pde_t *pgdir, char *uva);
+void            shminit(void);
+int             shm_assign(void);
 
 // number of elements in fixed-size array
 #define NELEM(x) (sizeof(x)/sizeof((x)[0]))
diff --git a/main.c b/main.c
index 9924e64..b1d7e4d 100644
--- a/main.c
+++ b/main.c
@@ -24,6 +24,7 @@ main(void)
   seginit();       // segment descriptors
   picinit();       // disable pic
   ioapicinit();    // another interrupt controller
+  shminit();       // init shared memory
   consoleinit();   // console hardware
   uartinit();      // serial port
   pinit();         // process table
diff --git a/syscall.c b/syscall.c
index ee85261..7631685 100644
--- a/syscall.c
+++ b/syscall.c
@@ -103,6 +103,7 @@ extern int sys_unlink(void);
 extern int sys_wait(void);
 extern int sys_write(void);
 extern int sys_uptime(void);
+extern int sys_shmget(void);
 
 static int (*syscalls[])(void) = {
 [SYS_fork]    sys_fork,
@@ -126,6 +127,7 @@ static int (*syscalls[])(void) = {
 [SYS_link]    sys_link,
 [SYS_mkdir]   sys_mkdir,
 [SYS_close]   sys_close,
+[SYS_shmget]  sys_shmget,
 };
 
 void
diff --git a/syscall.h b/syscall.h
index bc5f356..2f36d70 100644
--- a/syscall.h
+++ b/syscall.h
@@ -20,3 +20,4 @@
 #define SYS_link   19
 #define SYS_mkdir  20
 #define SYS_close  21
+#define SYS_shmget 22
diff --git a/sysproc.c b/sysproc.c
index 0686d29..e76f36b 100644
--- a/sysproc.c
+++ b/sysproc.c
@@ -89,3 +89,11 @@ sys_uptime(void)
   release(&tickslock);
   return xticks;
 }
+
+int
+sys_shmget(void)
+{
+  if (shm_assign() < 0)
+    return -1;
+  return 0;
+}
diff --git a/testshm.c b/testshm.c
new file mode 100644
index 0000000..c96ca7a
--- /dev/null
+++ b/testshm.c
@@ -0,0 +1,23 @@
+#include "types.h"
+#include "user.h"
+
+#define SHM_VA 0x40000000
+
+int
+main(void)
+{
+  shmget();
+
+  int *x = (int*)SHM_VA;
+
+  if (fork() == 0) {
+    shmget();
+    sleep(100);
+    printf(1,"child: %d\n", *x);
+  } else {
+    *x = 1234;
+    wait();
+  }
+
+  exit();
+}
diff --git a/user.h b/user.h
index 4f99c52..202fdb8 100644
--- a/user.h
+++ b/user.h
@@ -23,6 +23,7 @@ int getpid(void);
 char* sbrk(int);
 int sleep(int);
 int uptime(void);
+int shmget(void);
 
 // ulib.c
 int stat(const char*, struct stat*);
diff --git a/usys.S b/usys.S
index 8bfd8a1..15bee23 100644
--- a/usys.S
+++ b/usys.S
@@ -29,3 +29,4 @@ SYSCALL(getpid)
 SYSCALL(sbrk)
 SYSCALL(sleep)
 SYSCALL(uptime)
+SYSCALL(shmget)
diff --git a/vm.c b/vm.c
index 7134cff..4ee83db 100644
--- a/vm.c
+++ b/vm.c
@@ -6,10 +6,17 @@
 #include "mmu.h"
 #include "proc.h"
 #include "elf.h"
+#include "spinlock.h"
 
 extern char data[];  // defined by kernel.ld
 pde_t *kpgdir;  // for use in scheduler()
 
+struct {
+  struct spinlock lock;
+  uint phys_addr;
+  int ref_count;
+} shm_table;
+
 // Set up CPU's kernel segment descriptors.
 // Run once on entry on each CPU.
 void
@@ -290,8 +297,20 @@ freevm(pde_t *pgdir)
   deallocuvm(pgdir, KERNBASE, 0);
   for(i = 0; i < NPDENTRIES; i++){
     if(pgdir[i] & PTE_P){
-      char * v = P2V(PTE_ADDR(pgdir[i]));
-      kfree(v);
+      uint p = PTE_ADDR(pgdir[i]);
+      char *v = P2V(p);
+
+      acquire(&shm_table.lock);
+      if (shm_table.phys_addr != 0 && p == shm_table.phys_addr) {
+        shm_table.ref_count--;
+        if (shm_table.ref_count == 0) {
+          kfree(v);
+          shm_table.phys_addr = 0;
+        }
+      } else {
+        kfree(v);
+      }
+      release(&shm_table.lock);
     }
   }
   kfree((char*)pgdir);
@@ -392,3 +411,52 @@ copyout(pde_t *pgdir, uint va, void *p, uint len)
 //PAGEBREAK!
 // Blank page.
 
+void
+shminit(void)
+{
+  initlock(&shm_table.lock, "shm");
+  shm_table.phys_addr = 0;
+  shm_table.ref_count = 0;
+}
+
+int
+shm_assign(void)
+{
+  struct proc *p = myproc();
+  uint va = 0x40000000;
+
+  acquire(&shm_table.lock);
+
+  if (shm_table.phys_addr == 0) {
+    shm_table.phys_addr = V2P(kalloc());
+    if (shm_table.phys_addr == 0) {
+      release(&shm_table.lock);
+      return -1;
+    }
+    memset(P2V(shm_table.phys_addr), 0, PGSIZE);
+    shm_table.ref_count = 0;
+  }
+
+  pte_t *pte = walkpgdir(p->pgdir, (void*)va, 0);
+
+  if(*pte & PTE_P){
+    uint pa = PTE_ADDR(*pte);
+    if(pa != V2P(shm_table.phys_addr)){
+      kfree(P2V(pa));
+      *pte = 0;
+    } else {
+      release(&shm_table.lock);
+      return 0;
+    }
+  }
+
+  if(mappages(p->pgdir, (void*)va, PGSIZE, shm_table.phys_addr, PTE_W|PTE_U) < 0){
+    release(&shm_table.lock);
+    return -1;
+  }
+
+  shm_table.ref_count++;
+  release(&shm_table.lock);
+
+  return 0;
+}
-- 
2.52.0

