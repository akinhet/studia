diff --git a/colortest.c b/colortest.c
new file mode 100644
index 0000000..10e217a
--- /dev/null
+++ b/colortest.c
@@ -0,0 +1,15 @@
+#include "types.h"
+#include "stat.h"
+#include "user.h"
+
+int main(int argc, char *argv[])
+{
+	if (argc < 2) {
+		for (int i = 0; i <= 0xFF; i++)
+			printf(1, "\e%xmHello, World\em\n", i);
+		exit();
+	}
+
+	printf(1, "\e%smHello, World\em\n", argv[1]);
+	exit();
+}
diff --git a/console.c b/console.c
index a280d2b..6eee41a 100644
--- a/console.c
+++ b/console.c
@@ -128,6 +128,11 @@ panic(char *s)
 #define CRTPORT 0x3d4
 static ushort *crt = (ushort*)P2V(0xb8000);  // CGA memory
 
+static unsigned char color      = 0x07,
+					 temp_color = 0;
+
+static enum { NORMAL, COLOR, BG, END } esc_state = NORMAL;
+
 static void
 cgaputc(int c)
 {
@@ -139,12 +144,60 @@ cgaputc(int c)
   outb(CRTPORT, 15);
   pos |= inb(CRTPORT+1);
 
+  switch (esc_state) {
+    case COLOR:
+		if (c <= '9' && c >= '0') {
+			temp_color = (c  - '0');
+			esc_state = BG;
+			return;
+		}
+		if (c <= 'F' && c >= 'A') {
+			temp_color = (c  - 'A');
+			esc_state = BG;
+			return;
+		}
+		if (c == 'm') {
+			color = 0x07;
+		}
+		esc_state = NORMAL;
+		return;
+	case BG:
+		if (c <= '9' && c >= '0') {
+			temp_color = (((c  - '0') << 4) & 0xF0) | (temp_color & 0x0F);
+			esc_state = END;
+			return;
+		}
+		if (c <= 'F' && c >= 'A') {
+			temp_color = (((c  - 'A') << 4) & 0xF0) | (temp_color & 0x0F);
+			esc_state = END;
+			return;
+		}
+		if (c == 'm') {
+			color = temp_color;
+			esc_state = NORMAL;
+			return;
+		}
+		esc_state = NORMAL;
+		return;
+	case END:
+		if (c == 'm') {
+			color = temp_color;
+		}
+		esc_state = NORMAL;
+		return;
+	default:
+		break;
+  }
+
   if(c == '\n')
     pos += 80 - pos%80;
   else if(c == BACKSPACE){
     if(pos > 0) --pos;
+  } else if(c == '\e') {
+    esc_state = COLOR;
+    return;
   } else
-    crt[pos++] = (c&0xff) | 0x0700;  // black on white
+    crt[pos++] = (c&0xff) | (color << 8);  // black on white
 
   if(pos < 0 || pos > 25*80)
     panic("pos under/overflow");
