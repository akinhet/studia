digraph G {
    graph [rankdir=LR, splines=true];
    node [shape=circle];
    edge [fontsize=10];

    1 [style=filled, fillcolor=lightgreen];
    10 [style=filled, fillcolor=lightcoral];

    1 -> 2  [label="3, 4", color=green, penwidth=3];
    1 -> 3  [label="4, 9", color=red, penwidth=3, style=dashed];
    1 -> 4  [label="7, 10"];
    1 -> 5  [label="8, 12"];

    2 -> 3  [label="2, 3", color=green, penwidth=3];

    3 -> 4  [label="4, 6"];
    3 -> 5  [label="2, 2", color=green, penwidth=3];
    3 -> 10 [label="6, 11", color=red, penwidth=3, style=dashed];

    4 -> 5  [label="1, 1"];
    4 -> 7  [label="3, 5"];

    5 -> 6  [label="5, 6"];
    5 -> 7  [label="3, 3", color=green, penwidth=3];
    5 -> 10 [label="5, 8"];

    6 -> 1  [label="5, 8"];
    6 -> 7  [label="2, 2"];
    6 -> 10 [label="7, 11"];

    7 -> 3  [label="4, 6"];
    7 -> 8  [label="3, 5"];
    7 -> 9  [label="1, 1", color=green, penwidth=3];

    8 -> 9  [label="1, 2"];

    9 -> 10 [label="2, 2", color=green, penwidth=3];
}
