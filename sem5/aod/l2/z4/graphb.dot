digraph G {
    graph [rankdir=LR, splines=true];
    node [shape=circle];
    edge [fontsize=10];

    1 [style=filled, fillcolor=lightgreen];
    10 [style=filled, fillcolor=lightcoral];

    1 -> 2  [label="1, 10", color=red, penwidth=3, style=dashed];
    1 -> 3  [label="2, 3", color=green, penwidth=3];

    2 -> 5  [label="3, 4"];
    2 -> 10 [label="1, 10", color=red, penwidth=3, style=dashed];

    3 -> 4  [label="2, 3", color=green, penwidth=3];
    3 -> 7  [label="4, 4"];

    4 -> 10 [label="2, 3", color=green, penwidth=3];
    4 -> 9  [label="3, 3"];

    5 -> 6  [label="3, 3"];

    6 -> 10 [label="3, 3"];

    7 -> 8  [label="3, 3"];

    8 -> 10 [label="4, 3"];

    9 -> 10 [label="3, 3"];
}
