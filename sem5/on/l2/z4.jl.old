using Polynomials
using Printf

# p = Polynomial([1, -210.0, 20615.0,-1256850.0,
#       53327946.0, -1672280820.0, 40171771630.0, -756111184500.0,          
#       11310276995381.0, -135585182899530.0,
#       1307535010540395.0,     -10142299865511450.0,
#       63030812099294896.0,     -311333643161390640.0,
#       1206647803780373360.0,     -3599979517947607200.0,
#       8037811822645051776.0,      -12870931245150988800.0,
#       13803759753640704000.0,      -8752948036761600000.0,
# 	  2432902008176640000.0])
#
#
# pmod = Polynomial([1, -210.0 - 2.0^(-23), 20615.0,-1256850.0,
#       53327946.0, -1672280820.0, 40171771630.0, -756111184500.0,          
#       11310276995381.0, -135585182899530.0,
#       1307535010540395.0,     -10142299865511450.0,
#       63030812099294896.0,     -311333643161390640.0,
#       1206647803780373360.0,     -3599979517947607200.0,
#       8037811822645051776.0,      -12870931245150988800.0,
#       13803759753640704000.0,      -8752948036761600000.0,
# 	  2432902008176640000.0])

P_exact = fromroots(BigInt.(1:20))
P = Polynomial(Float64.(coeffs(P_exact)))

# Pierwiastki obliczone numerycznie
z = sort(roots(P), by=real)

# Postać iloczynowa (x-1)(x-2)...(x-20)
function p(x)
    prod(x - k for k in 1:20)
end

println(" k            z_k              |P(z_k)|        |p(z_k)|       |z_k-k|")

for k in 1:20
    zk = z[k]

    @printf("%2d  %22.14g  %14.6e  %14.6e  %14.6e\n",
            k, zk, abs(P(zk)), abs(p(zk)), abs(zk - k))
end

# Zmodyfikowany wielomian
a = copy(coeffs(P))
a[20] -= 2.0^(-23)

Q = Polynomial(a)

# Pierwiastki zmodyfikowanego wielomianu
z2 = sort(roots(Q), by=real)

println("\nPo zmianie współczynnika:")

for k in 1:20
    zk = z2[k]

    @printf("%2d  %22.14g  %14.6e  %14.6e\n",
            k, zk, abs(Q(zk)), abs(p(zk)))
end
