#!/bin/bash

# Kompilacja programu
gcc -O3 main.c -o bst_test

# Nagłówek pliku wynikowego
# echo "n,scenariusz,avg_ins_comp,max_ins_comp,avg_ins_ptr,max_ins_ptr,avg_ins_h,max_ins_h,avg_del_comp,max_del_comp,avg_del_ptr,max_del_ptr,avg_del_h,max_del_h" > wyniki.csv

echo "Uruchamianie eksperymentów..."

# Pętla po wielkości danych n
for n in 70000 80000 90000 100000
do
    echo "Testowanie n = $n..."
    # Scenariusz A: ciąg rosnący (asc = 1)
    ./bst_test $n 1 >> wyniki.csv

    # Scenariusz B: ciąg losowy (asc = 0)
    ./bst_test $n 0 >> wyniki.csv
done

echo "Gotowe! Wyniki zapisano w pliku wyniki.csv"
